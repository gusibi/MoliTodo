---
import type { Locale } from '../../i18n/utils';
import { getStaticPaths, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import FeaturesGrid from '../../components/FeaturesGrid.astro';
import AIShowcase from '../../components/AIShowcase.astro';
import MultiViewShowcase from '../../components/MultiViewShowcase.astro';
import PrivacySection from '../../components/PrivacySection.astro';
import DownloadSection from '../../components/DownloadSection.astro';
import Footer from '../../components/Footer.astro';

export { getStaticPaths };

const { lang } = Astro.props as { lang: Locale };
const { t } = await useTranslations(lang);
---

<BaseLayout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <Navbar lang={lang} t={t} />
  <main id="main-content">
    <Hero lang={lang} t={t} />
    <FeaturesGrid lang={lang} t={t} />
    <AIShowcase lang={lang} t={t} />
    <MultiViewShowcase lang={lang} t={t} />
    <PrivacySection lang={lang} t={t} />
    <DownloadSection lang={lang} t={t} />
  </main>
  <Footer lang={lang} t={t} />
</BaseLayout>

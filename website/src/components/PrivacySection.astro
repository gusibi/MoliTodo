---
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;

const items = [
  { key: 'local', icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01' },
  { key: 'openSource', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { key: 'noTelemetry', icon: 'M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636' },
  { key: 'export', icon: 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4' },
];
---

<section class="py-20 sm:py-28 bg-gray-50 dark:bg-gray-900/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-text dark:text-text-dark mb-4">
        {t('privacy.title')}
      </h2>
      <p class="text-lg text-muted dark:text-muted-dark max-w-2xl mx-auto">
        {t('privacy.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {items.map((item) => (
        <div class="flex gap-5 p-6 bg-white dark:bg-gray-800/50 rounded-2xl border border-border dark:border-border-dark">
          <div class="flex-shrink-0 w-14 h-14 bg-green-50 dark:bg-green-900/20 rounded-xl flex items-center justify-center text-green-600 dark:text-green-400">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-text dark:text-text-dark mb-2">
              {t(`privacy.${item.key}`)}
            </h3>
            <p class="text-muted dark:text-muted-dark leading-relaxed">
              {t(`privacy.${item.key}Desc`)}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

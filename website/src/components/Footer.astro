---
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;

const productLinks = [
  { href: '#features', label: t('footer.features') },
  { href: '#download', label: t('footer.download') },
  { href: 'https://github.com/gusibi/MoliTodo/releases', label: t('footer.changelog'), external: true },
];

const resourceLinks = [
  { href: `/${lang}/about/`, label: t('footer.about'), external: false },
  { href: `/${lang}/api/`, label: t('footer.api'), external: false },
];

const communityLinks = [
  { href: 'https://github.com/gusibi/MoliTodo', label: t('footer.github'), external: true },
  { href: 'https://github.com/gusibi/MoliTodo/issues', label: t('footer.issues'), external: true },
  { href: 'https://github.com/gusibi/MoliTodo/discussions', label: t('footer.discussions'), external: true },
];
---

<footer class="bg-gray-50 dark:bg-gray-900/50 border-t border-border dark:border-border-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/favicon.png" alt="MoliTodo" class="w-8 h-8 rounded-lg" width="32" height="32" />
          <span class="text-lg font-bold text-text dark:text-text-dark">MoliTodo</span>
        </div>
        <p class="text-sm text-muted dark:text-muted-dark max-w-xs leading-relaxed">
          {t('hero.subtitle')}
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-sm font-semibold text-text dark:text-text-dark mb-4">{t('footer.product')}</h3>
        <ul class="space-y-3">
          {productLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-text dark:text-text-dark mb-4">{t('footer.resources')}</h3>
        <ul class="space-y-3">
          {resourceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h3 class="text-sm font-semibold text-text dark:text-text-dark mb-4">{t('footer.community')}</h3>
        <ul class="space-y-3">
          {communityLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border dark:border-border-dark flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-muted dark:text-muted-dark">
        {t('footer.copyright')}
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/gusibi/MoliTodo/blob/main/LICENSE"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors"
        >
          {t('footer.license')}
        </a>
        <a
          href="https://github.com/gusibi/MoliTodo"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

---
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const descriptions: Record<Locale, string> = {
  zh: 'AI智能驱动的悬浮式桌面待办事项应用。让任务管理变得简单、智能、高效。',
  en: 'AI-powered floating desktop task manager. Making task management simple, intelligent, and efficient.',
  ja: 'AI搭載フローディングデスクトップタスク管理アプリ。タスク管理をシンプルに、スマートに、効率的に。',
  ko: 'AI 기반 플로팅 데스크톱 태스크 관리 앱. 태스크 관리를 간단하고 스마트하게.',
  fr: 'Gestionnaire de tâches flottant pour bureau alimenté par l\'IA. Simple, intelligent, efficace.',
  de: 'KI-gesteuerter schwebender Desktop-Task-Manager. Aufgabenverwaltung einfach, intelligent, effizient.',
  es: 'Gestor de tareas flotante de escritorio impulsado por IA. Simple, inteligente, eficiente.',
  pt: 'Gerenciador de tarefas flutuante para desktop com IA. Simples, inteligente, eficiente.',
  ru: 'ИИ-менеджер задач для рабочего стола. Простой, умный, эффективный.',
  ar: 'مدير مهام متحرك لسطح المكتب مدعوم بالذكاء الاصطناعي. بسيط وذكي وفعال.',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MoliTodo',
  description: descriptions[lang],
  operatingSystem: 'macOS, Windows',
  applicationCategory: 'ProductivityApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'gusibi',
    url: 'https://github.com/gusibi',
  },
  license: 'https://opensource.org/licenses/MIT',
  softwareVersion: '1.3.0',
  downloadUrl: 'https://github.com/gusibi/MoliTodo/releases',
  screenshot: 'https://molitodo.eztoolab.com/screenshots/task-manager-demo.png',
  url: 'https://molitodo.eztoolab.com',
  isAccessibleForFree: true,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

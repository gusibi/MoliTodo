---
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;
---

<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 start-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-to-b from-blue-500/10 via-blue-400/5 to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text content -->
      <div class="text-center lg:text-start animate-slide-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 dark:bg-blue-900/20 text-primary rounded-full text-sm font-medium mb-6">
          <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
          {t('hero.version')}
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-text dark:text-text-dark leading-tight mb-6">
          {t('hero.tagline')}
        </h1>

        <p class="text-lg sm:text-xl text-muted dark:text-muted-dark max-w-xl mx-auto lg:mx-0 mb-10 leading-relaxed">
          {t('hero.subtitle')}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="#download"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-primary hover:bg-primary-dark text-white font-medium rounded-xl transition-colors shadow-lg shadow-primary/25"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {t('hero.ctaDownload')}
          </a>
          <a
            href="https://github.com/gusibi/MoliTodo"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 border-2 border-border dark:border-border-dark hover:border-gray-400 dark:hover:border-gray-500 text-text dark:text-text-dark font-medium rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            {t('hero.ctaGitHub')}
          </a>
        </div>
      </div>

      <!-- Hero image -->
      <div class="relative animate-slide-up delay-200">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-gray-900/10 dark:shadow-black/30 border border-gray-200 dark:border-gray-700">
          <img
            src="/screenshots/task.png"
            alt="MoliTodo floating desktop icon"
            class="w-full h-auto"
            width="1200"
            height="800"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <!-- Floating decoration -->
        <div class="absolute -bottom-6 -start-6 w-24 h-24 bg-blue-500/10 rounded-full blur-xl"></div>
        <div class="absolute -top-4 -end-4 w-32 h-32 bg-blue-400/10 rounded-full blur-xl"></div>
      </div>
    </div>
  </div>
</section>

{
  "name": "moli-todo",
  "version": "1.5.5",
  "description": "一款常驻在桌面边缘的悬浮式待办事项应用",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build:renderer && playwright test",
    "test:e2e:today": "npm run build:renderer && playwright test e2e/today-overview.spec.js",
    "dev": "npm run rebuild && node dev-start.js",
    "dev:renderer": "vite --config src/renderer/vite.config.js",
    "dev:clean": "npm run rebuild && npm run dev",
    "rebuild": "electron-rebuild",
    "build:renderer": "vite build --config src/renderer/vite.config.js",
    "generate:icon-variants": "python3 scripts/generate-icon-variants.py",
    "build": "npm run build:renderer && electron-builder",
    "build:mac": "npm run build",
    "build:win": "npm run build",
    "postinstall": "electron-builder install-app-deps",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "release": "npm run version:patch"
  },
  "keywords": [
    "todo",
    "floating",
    "productivity",
    "electron",
    "vue",
    "macos"
  ],
  "author": "MoliTodo Team",
  "license": "MIT",
  "devDependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/vue3": "^6.1.19",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.47.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vuepic/vue-datepicker": "^11.0.2",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^7.6.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "marked": "^16.2.1",
    "pinia": "^2.1.7",
    "postcss": "^8.5.6",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.180.0",
    "v-calendar": "^3.1.2",
    "vite": "^4.5.14",
    "vue": "^3.3.8",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.6",
    "@ai-sdk/google": "^2.0.8",
    "@ai-sdk/openai": "^2.0.19",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^5.0.22",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.11",
    "node-schedule": "^2.1.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^4.1.1"
  },
  "build": {
    "appId": "com.MoliTodo.app",
    "productName": "MoliTodo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/domain/**/*",
      "src/infrastructure/**/*",
      "src/application/**/*",
      "src/renderer/dist/**/*",
      "src/utils/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.map",
      "!node_modules/sqlite3/deps/**",
      "!node_modules/sqlite3/src/**",
      "!node_modules/sqlite3/build/Release/obj/**",
      "!node_modules/sqlite3/build/deps/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gusibi",
        "repo": "MoliTodo"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": "x64"
        },
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "icon": "resources/icon.icns",
      "extraResources": [
        {
          "from": "resources",
          "to": "resources",
          "filter": [
            "**/*",
            "!logos/*.png",
            "!logos/windows/**",
            "!icon.png",
            "!icon.icns",
            "!icon.ico",
            "!**/.DS_Store"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "resources",
          "to": "resources",
          "filter": [
            "**/*",
            "!logos/*.png",
            "!logos/macos/**",
            "!icon.png",
            "!icon.icns",
            "!icon.ico",
            "!**/.DS_Store"
          ]
        }
      ]
    }
  }
}
